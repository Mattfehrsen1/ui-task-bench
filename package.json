{
  "name": "ui-task-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend coding tasks built from visual references, with hidden graders that pass the reference and reject shortcuts.",
  "license": "MIT",
  "author": "Matthew Fehrsen",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "grade": "node grade/grade.ts",
    "verify": "node grade/verify.ts",
    "snapshots": "node grade/snapshots.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
